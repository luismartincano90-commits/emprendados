function renderPalermoView(){
  let html=`<div class="page-header"><div><h2>Final Palermo — Clasificados</h2>
    <p>Reglamento SRA · mín. 55 pts aperos · 60 pts Cat B · 70 pts Cat A · 48 pts Petisos</p></div></div>
