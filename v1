    html+=`<div class="palermo-card ${clasificados.length?'has-data':''}">
      <div class="palermo-card-header">
        <h3>${cat.name}</h3>
        <p>${clasificados.length} clasificado${clasificados.length!==1?'s':''} · ${cat.directFinal?'Acceso directo':`mín.${cat.minPts}pts`}</p>
      </div>`;
    if(!clasificados.length){html+=`<div class="palermo-empty">Sin clasificados aún</div>`;}
    else clasificados.sort((a,b)=>a.apellido.localeCompare(b.apellido)).forEach((p,i)=>{
      html+=`<div class="palermo-row">
        <span class="palermo-num">${i+1}</span>
        <span class="palermo-name">${p.apellido}${p.nombre?' '+p.nombre:''}</span>
        <div class="palermo-etapas">
          ${(p.clasificoEn||[]).map(eid=>{const ei=['e1','e2','e3','e4'].indexOf(eid);return`<span class="etapa-dot participó" style="font-size:.48rem;width:22px;border-radius:3px">${getEvName(EVENTS.find(e=>e.id===eid)).substring(0,5)}</span>`;}).join('')}
        </div>
      </div>`;
    });
    html+=`</div>`;
  });
  html+=`</div>`;
  document.getElementById('main-area').innerHTML=html;
}

