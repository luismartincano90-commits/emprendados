}

async function syncFromDB(){
  if(!isOnline) return;
  setSyncStatus('syncing','Sincronizando...');
  try{
    const {data:insc}=await db.from('inscriptos').select('*');
    const {data:punts}=await db.from('puntajes').select('*');
    const {data:cfg}=await db.from('config').select('*');

    if(insc) insc.forEach(r=>{
      if(!state.inscripcion[r.evento])state.inscripcion[r.evento]={};
      if(!state.inscripcion[r.evento][r.categoria])state.inscripcion[r.evento][r.categoria]=[];
      state.inscripcion[r.evento][r.categoria][r.slot]={apellido:r.apellido,nombre:r.nombre,ejemplar:r.ejemplar,tel:r.tel,mail:r.mail,db_id:r.id};
    });
    if(punts) punts.forEach(r=>{
      if(!state.puntajes[r.evento])state.puntajes[r.evento]={};
      if(!state.puntajes[r.evento][r.categoria])state.puntajes[r.evento][r.categoria]=[];
      state.puntajes[r.evento][r.categoria][r.slot]=r.scores;
    });
    if(cfg) cfg.forEach(r=>{
      if(r.key==='eventNames') state.eventNames=r.value;
      if(r.key==='catSlots') state.catSlots=r.value;
    });
    persist();
    setSyncStatus('online','Sincronizado · '+new Date().toLocaleTimeString('es-AR',{hour:'2-digit',minute:'2-digit'}));
    renderAll();
  }catch(e){
    setSyncStatus('offline','Sin conexión · datos locales');
  }
}

