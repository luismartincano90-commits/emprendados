async function loadSampleData(){
  const apellidos=['GARCIA','RODRIGUEZ','LOPEZ','MARTINEZ','GONZALEZ','FERNANDEZ','PEREZ','SANCHEZ',
    'ROMERO','TORRES','DIAZ','GUTIERREZ','MORALES','HERRERA','MOLINA','VARGAS','CASTRO','SUAREZ',
    'REYES','ORTIZ','CABRAL','PEREYRA','ACOSTA','MENDEZ','SILVA','RIOS','LUNA','MEDINA',
    'CHAVEZ','ALVAREZ','FLORES','VEGA','RAMOS','AGUIRRE','BECERRA','MIÑO','OLGUIN','SOSA'];
  const nombres=['Juan','Carlos','Pedro','Miguel','Diego','Roberto','Eduardo','Gustavo','Mario',
    'Alejandro','Daniel','Pablo','Ricardo','Andrés','Facundo','Nicolás','Sebastián','Matías',
    'Ezequiel','Lucas','Santiago','Federico','Ramón','Héctor','Alfredo','Osvaldo','Jorge','Adrián'];
  const caballos=['Compadre','Dorado','Gaucho','Pampa','Criollo','Caudillo','Pampero','Alazán',
    'Tordillo','Overo','Malacara','Picazo','Sultán','Negro','Mancha','Bayo','Rosillo','Zaino',
    'Tostado','Gateado','Colorado','Moro','Ruano','Tordo','Malabar','Fortín','Pampeano','Llanero'];
  let seed=1973;
  function rand(){seed=Math.imul(seed,1664525)+1013904223|0;return(seed>>>0)/4294967296;}
  function pick(arr){return arr[Math.floor(rand()*arr.length)];}
  function pts(min,max){return Math.round((min+rand()*(max-min))*2)/2;}

  if(!state.eventNames)state.eventNames={};
  state.eventNames.e1='Expo Rural Córdoba (Ago 2025)';
  state.eventNames.e2='Rural del Litoral (Sep 2025)';
  state.eventNames.e3='Expo Pampeana (Nov 2025)';
  state.eventNames.e4='Rural Patagónica (Mar 2026)';
  await saveConfigToDB('eventNames',state.eventNames);

  const etapas=['e1','e2','e3','e4'];
  let totalCount=0;
  for(const eid of etapas){
    for(const cat of CATEGORIES){
      const maxPts=(CRITERIA[cat.type]&&CRITERIA[cat.type].maxPts)||100;
      const minPts=cat.minPts||50;
      const count=8+Math.floor(rand()*7);
      if(!state.inscripcion[eid])state.inscripcion[eid]={};
      if(!state.inscripcion[eid][cat.id])state.inscripcion[eid][cat.id]=[];
      if(!state.puntajes[eid])state.puntajes[eid]={};
      if(!state.puntajes[eid][cat.id])state.puntajes[eid][cat.id]=[];
      for(let i=0;i<count;i++){
        const apellido=pick(apellidos);
        const nombre=pick(nombres);
        const ejemplar=pick(caballos);
        let puntaje;
        if(rand()<0.28){puntaje=pts(maxPts*0.40,minPts-0.5);}
        else{puntaje=pts(minPts,maxPts*0.97);}
        puntaje=Math.max(0,Math.min(maxPts,Math.round(puntaje*2)/2));
        const slot=state.inscripcion[eid][cat.id].length;
        const obj={apellido,nombre,ejemplar};
        state.inscripcion[eid][cat.id].push(obj);
        state.puntajes[eid][cat.id].push({_total:puntaje});
        await saveInscriptoDB(eid,cat.id,slot,obj);
        await savePuntajeToDB(eid,cat.id,slot,{_total:puntaje});
        totalCount++;
      }
    }
  }
  persist();
  renderAll();
  toast('✓ Datos 2025-2026 cargados: '+totalCount+' participantes en 4 etapas');
}

