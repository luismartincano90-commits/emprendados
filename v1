async function saveInscripto(){
  const apellido=document.getElementById('f-apellido').value.trim();
  if(!apellido){toast('⚠ Ingresá el apellido');return;}
  const obj={apellido,nombre:document.getElementById('f-nombre').value.trim(),
    ejemplar:document.getElementById('f-ejemplar').value.trim(),
    tel:document.getElementById('f-tel').value.trim(),
    mail:document.getElementById('f-mail').value.trim()};
  const cat=CATEGORIES.find(c=>c.id===curCat);
  const slots=getCatSlots(cat.id);
  while(state.inscripcion[curEvent][curCat].length<slots)state.inscripcion[curEvent][curCat].push(null);
  let slot=editIdx;
  if(editIdx!==null){
    state.inscripcion[curEvent][curCat][editIdx]=obj;
  } else {
    const free=state.inscripcion[curEvent][curCat].findIndex(r=>!r||!r.apellido);
    if(free>=0){state.inscripcion[curEvent][curCat][free]=obj;slot=free;}
    else{toast('⚠ No hay lugares disponibles');return;}
  }
  persist();
  await saveInscriptoDB(curEvent,curCat,slot,obj);
  closeModal('modal-insc');
  renderAll();toast('✓ Inscripto guardado');
}

async function deleteInsc(idx){
  if(!confirm('¿Eliminar este inscripto?'))return;
  state.inscripcion[curEvent][curCat][idx]=null;
  persist();
  await db.from('inscriptos').delete().match({evento:curEvent,categoria:curCat,slot:idx}).catch(()=>{});
  renderAll();toast('Inscripto eliminado');
}

