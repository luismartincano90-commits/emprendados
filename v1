<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Emprendados SRA</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Lato:wght@300;400;700&display=swap');
:root {
  --navy:#002060;--navy2:#003090;--gold:#ffffff;--gold2:#e8eef8;
  --cream:#f4f7fb;--light:#e8eef8;--border:#b8c8e0;--text:#000000;
  --mid:#002060;--green:#2E7D32;--red:#C62828;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Lato',sans-serif;background:var(--cream);color:var(--text);min-height:100vh;text-transform:uppercase;}

/* ══ LOGIN ══ */
.login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--navy);position:relative;overflow:hidden;}
.login-wrap::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 30% 50%,rgba(255,255,255,.06) 0%,transparent 60%);}
.login-box{background:#fff;border-radius:12px;padding:36px 44px;width:100%;max-width:400px;box-shadow:0 24px 80px rgba(0,0,0,.5);border-top:5px solid var(--navy);position:relative;z-index:1;}
.login-logo{font-family:'Cinzel',serif;font-size:1.4rem;color:var(--navy);text-align:center;margin-bottom:2px;letter-spacing:.06em;text-transform:uppercase;font-weight:900;}
.login-logo span{color:var(--navy);}
.login-sub{text-align:center;font-size:.68rem;color:#666;letter-spacing:.16em;text-transform:uppercase;margin-bottom:20px;font-weight:700;}
.login-roles{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px;}
.role-btn{padding:16px 10px;border:2px solid var(--border);border-radius:8px;background:#fff;cursor:pointer;font-family:'Lato',sans-serif;font-size:.75rem;font-weight:700;color:var(--navy);transition:all .18s;text-align:center;text-transform:uppercase;letter-spacing:.08em;}
.role-btn:hover{border-color:var(--navy);background:var(--light);}
.role-btn.selected{border-color:var(--navy);background:var(--navy);color:#fff;}
.role-btn .role-icon{font-size:1.4rem;display:block;margin-bottom:6px;}
.pin-wrap{margin-bottom:20px;}
.pin-label{font-size:.66rem;text-transform:uppercase;letter-spacing:.12em;color:#555;margin-bottom:8px;font-weight:700;}
.pin-input{width:100%;padding:12px 14px;border:2px solid var(--border);border-radius:6px;font-family:'Lato',sans-serif;font-size:1.1rem;letter-spacing:.3em;text-align:center;outline:none;transition:border-color .15s;}
.pin-input:focus{border-color:var(--navy);}
.login-err{color:var(--red);font-size:.75rem;text-align:center;margin-bottom:12px;min-height:18px;text-transform:uppercase;font-weight:700;}
.btn-login{width:100%;padding:14px;background:var(--navy);color:#fff;border:none;border-radius:6px;font-family:'Lato',sans-serif;font-size:.82rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;transition:background .18s;}
.btn-login:hover{background:var(--navy2);}

/* ══ TOPBAR ══ */
.topbar{background:var(--navy);padding:10px 24px;display:flex;align-items:center;justify-content:space-between;border-bottom:3px solid rgba(255,255,255,.25);position:sticky;top:0;z-index:200;box-shadow:0 2px 16px rgba(0,0,0,.45);}
.topbar-left h1{font-family:'Cinzel',serif;font-size:1.1rem;color:#fff;letter-spacing:.1em;text-transform:uppercase;}
.topbar-left h1 span{color:#fff;}
.topbar-left p{color:rgba(255,255,255,.4);font-size:.65rem;letter-spacing:.14em;text-transform:uppercase;margin-top:2px;}
.topbar-right{display:flex;gap:8px;align-items:center;}
.role-badge{padding:4px 12px;border-radius:20px;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;}
.role-badge.admin{background:#fff;color:var(--navy);}
.role-badge.caballos{background:#1D9E75;color:#fff;}
.role-badge.aperos{background:#534AB7;color:#fff;}
.role-badge.lectura{background:#666;color:#fff;}

/* ══ EVENT TABS ══ */
.event-tabs{background:var(--navy);border-bottom:2px solid rgba(255,255,255,.2);display:flex;overflow-x:auto;gap:0;}
.etab{padding:10px 20px;border:none;background:none;color:rgba(255,255,255,.5);font-family:'Lato',sans-serif;font-size:.76rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;border-bottom:3px solid transparent;transition:all .2s;white-space:nowrap;}
.etab:hover{color:#fff;background:rgba(255,255,255,.05);}
.etab.active{color:#fff;border-bottom-color:#fff;}
.etab.palermo{color:#b8cce8;}
.etab.palermo.active{color:#fff;border-bottom-color:#fff;}
.etab-name-input{background:transparent;border:none;border-bottom:1.5px solid #fff;color:#fff;font-family:'Lato',sans-serif;font-size:.76rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;outline:none;width:120px;text-align:center;padding:1px 4px;}
.etab .edit-hint{font-size:.52rem;color:rgba(255,255,255,.2);display:block;text-align:center;margin-top:1px;}

/* ══ LAYOUT ══ */
.layout{display:flex;height:calc(100vh - 115px);}
.sidebar{width:230px;min-width:230px;background:#fff;border-right:1px solid var(--border);overflow-y:auto;padding:10px 0;}
.sidebar-section{font-size:.58rem;letter-spacing:.15em;text-transform:uppercase;color:#aaa;padding:10px 14px 6px;font-weight:700;}
.mode-tabs{display:flex;border-bottom:1px solid var(--border);}
.modetab{flex:1;padding:9px 4px;border:none;background:none;font-family:'Lato',sans-serif;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;cursor:pointer;color:#aaa;border-bottom:2px solid transparent;transition:all .2s;}
.modetab.active{color:var(--navy);border-bottom-color:var(--navy);}
.catbtn{width:100%;text-align:left;padding:7px 14px;border:none;background:none;cursor:pointer;font-family:'Lato',sans-serif;font-size:.75rem;color:var(--mid);transition:all .15s;border-left:3px solid transparent;display:flex;justify-content:space-between;align-items:center;gap:4px;}
.catbtn:hover{background:var(--light);color:var(--navy);}
.catbtn.active{background:var(--light);color:var(--navy);font-weight:700;border-left-color:var(--navy);}
.badge{font-size:.62rem;padding:1px 6px;border-radius:8px;background:#eee;color:#888;font-weight:700;white-space:nowrap;}
.catbtn.active .badge{background:var(--navy);color:#fff;}
.catbtn.has-scores .badge{background:var(--green);color:#fff;}

/* ══ MAIN ══ */
.main{flex:1;overflow-y:auto;padding:20px 26px;background:var(--cream);}
.page-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:16px;padding-bottom:12px;border-bottom:2px solid var(--border);}
.page-header h2{font-family:'Cinzel',serif;font-size:1rem;color:var(--navy);}
.page-header p{font-size:.7rem;color:#999;margin-top:2px;}
.page-header-actions{display:flex;gap:6px;flex-wrap:wrap;}

/* ══ BUTTONS ══ */
.btn{display:inline-flex;align-items:center;gap:5px;padding:7px 14px;border-radius:4px;border:none;font-family:'Lato',sans-serif;font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;transition:all .18s;}
.btn-gold{background:#fff;color:var(--navy);border:1.5px solid var(--navy);}
.btn-gold:hover{background:var(--light);}
.btn-navy{background:var(--navy);color:#fff;}
.btn-navy:hover{background:var(--navy2);}
.btn-ghost{background:transparent;color:var(--navy);border:1.5px solid var(--navy);}
.btn-ghost:hover{background:var(--navy);color:#fff;}
.btn-danger{background:#ffebee;color:var(--red);border:1.5px solid #ffcdd2;}
.btn-sm{padding:4px 10px;font-size:.66rem;}
.btn-xs{padding:2px 7px;font-size:.6rem;}

/* ══ TABLE ══ */
.table-wrap{overflow-x:auto;border-radius:6px;box-shadow:0 1px 8px rgba(0,0,0,.08);}
table{width:100%;border-collapse:collapse;background:#fff;font-size:.76rem;}
thead tr{background:var(--navy);}
thead th{padding:8px 6px;color:#fff;font-weight:700;font-size:.65rem;letter-spacing:.05em;text-transform:uppercase;text-align:center;border-right:1px solid rgba(255,255,255,.1);white-space:nowrap;}
tbody tr{border-bottom:1px solid #f0ebe3;transition:background .1s;}
tbody tr:hover{background:#fdf7ed;}
tbody td{padding:6px 6px;vertical-align:middle;text-align:center;}
tbody td.left{text-align:left;}
.num-cell{font-weight:700;color:var(--navy);font-size:.72rem;}
.name-cell{font-weight:700;text-align:left;}
.empty-row td{color:#ddd;font-style:italic;}
.score-input{width:50px;border:1px solid #ddd;border-radius:3px;padding:3px 4px;text-align:center;font-family:'Lato',sans-serif;font-size:.76rem;outline:none;transition:border-color .15s;}
.score-input:focus{border-color:var(--navy);background:#eef2ff;}
.score-input:disabled{background:#f5f5f5;color:#bbb;cursor:not-allowed;}
.score-input.over{border-color:var(--red);background:#ffebee;}
.total-cell{font-weight:700;color:var(--navy);font-size:.82rem;}
.rank-cell{font-weight:900;font-size:.88rem;}
.rank-1{color:var(--navy);font-weight:900;}.rank-2{color:#555;}.rank-3{color:#333;}
.obs-input{width:100%;min-width:90px;border:1px solid #ddd;border-radius:3px;padding:3px 5px;font-family:'Lato',sans-serif;font-size:.7rem;outline:none;}
.subtotal-cell{background:#f5f5f5;font-weight:700;color:var(--mid);}
.jury-header{background:#e8f0fe !important;color:var(--navy) !important;font-style:italic;}

/* ══ SLOTS BAR ══ */
.slots-bar{background:#fff;border:1px solid var(--border);border-radius:6px;padding:8px 14px;margin-bottom:12px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.slots-bar label{font-size:.68rem;text-transform:uppercase;letter-spacing:.08em;color:#888;font-weight:700;}
.slots-input{width:58px;border:1.5px solid var(--border);border-radius:4px;padding:4px 6px;font-family:'Lato',sans-serif;font-size:.85rem;font-weight:700;color:var(--navy);text-align:center;outline:none;}
.slots-input:focus{border-color:var(--navy);}
.slots-bar p{font-size:.68rem;color:#aaa;margin-left:auto;}

/* ══ SYNC STATUS ══ */
.sync-bar{background:var(--navy);padding:4px 24px;display:flex;align-items:center;gap:8px;font-size:.65rem;color:rgba(255,255,255,.5);}
.sync-dot{width:7px;height:7px;border-radius:50%;background:#666;}
.sync-dot.online{background:#2E7D32;animation:pulse 2s infinite;}
.sync-dot.syncing{background:#fff;animation:pulse .5s infinite;}
.sync-dot.offline{background:#666;}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

/* ══ PALERMO ══ */
.palermo-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px;}
.palermo-card{background:#fff;border-radius:8px;box-shadow:0 2px 10px rgba(0,0,0,.08);overflow:hidden;border-top:3px solid var(--navy);}
.palermo-card.has-data{border-top-color:var(--green);}
.palermo-card-header{background:var(--navy);color:#fff;padding:9px 12px;}
.palermo-card-header h3{font-family:'Cinzel',serif;font-size:.8rem;letter-spacing:.04em;}
.palermo-card-header p{font-size:.62rem;color:rgba(255,255,255,.5);margin-top:1px;}
.palermo-row{display:flex;align-items:center;padding:7px 12px;border-bottom:1px solid #f5f0e8;gap:8px;}
.palermo-row:last-child{border-bottom:none;}
.palermo-num{font-weight:900;color:var(--navy);font-size:.72rem;width:18px;text-align:center;}
.palermo-name{flex:1;font-weight:700;font-size:.76rem;}
.palermo-etapas{display:flex;gap:3px;}
.etapa-dot{width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.52rem;font-weight:700;}
.etapa-dot.participó{background:var(--green);color:#fff;}
.etapa-dot.no{background:#eee;color:#bbb;}
.palermo-empty{padding:20px;text-align:center;color:#bbb;font-size:.76rem;}

/* ══ MODAL ══ */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;z-index:300;padding:20px;}
.overlay.hidden{display:none;}
.modal{background:#fff;border-radius:8px;width:100%;max-width:480px;box-shadow:0 20px 60px rgba(0,0,0,.3);border-top:4px solid var(--navy);overflow:hidden;}
.modal-header{background:var(--navy);color:#fff;padding:16px 22px;}
.modal-header h3{font-family:'Cinzel',serif;font-size:.95rem;}
.modal-header p{font-size:.68rem;color:rgba(255,255,255,.5);margin-top:2px;}
.modal-body{padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:12px;max-height:60vh;overflow-y:auto;}
.field{display:flex;flex-direction:column;gap:4px;}
.field.full{grid-column:1/-1;}
.field label{font-size:.62rem;text-transform:uppercase;letter-spacing:.1em;color:#888;font-weight:700;}
.field input,.field select{padding:7px 9px;border:1.5px solid #ddd;border-radius:4px;font-family:'Lato',sans-serif;font-size:.8rem;outline:none;transition:border-color .15s;}
.field input:focus,.field select:focus{border-color:var(--navy);}
.modal-footer{padding:14px 22px;display:flex;justify-content:flex-end;gap:8px;border-top:1px solid var(--border);}

/* ══ ADMIN PANEL ══ */
.admin-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;}
.admin-card{background:#fff;border-radius:8px;padding:20px;box-shadow:0 2px 10px rgba(0,0,0,.08);border-top:3px solid var(--navy);border-left:1px solid var(--border);}
.admin-card h3{font-family:'Cinzel',serif;font-size:.9rem;color:var(--navy);margin-bottom:14px;}
.user-row{display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f5f0e8;gap:8px;}
.user-row:last-child{border-bottom:none;}
.user-info{flex:1;}
.user-info .user-name{font-weight:700;font-size:.8rem;}
.user-info .user-role{font-size:.68rem;color:#888;margin-top:1px;}
.user-pin{font-family:monospace;background:#f5f5f5;padding:2px 8px;border-radius:4px;font-size:.75rem;color:var(--navy);}

/* ══ TOAST ══ */
.toast{position:fixed;bottom:20px;right:20px;background:var(--navy);color:#fff;padding:10px 16px;border-radius:6px;font-size:.78rem;border-left:4px solid #fff;transform:translateY(60px);opacity:0;transition:all .28s;z-index:400;text-transform:uppercase;}
.toast.show{transform:translateY(0);opacity:1;}

/* ══ READONLY OVERLAY ══ */
.readonly-notice{background:#eef2f8;border:1px solid var(--navy);border-radius:6px;padding:8px 14px;margin-bottom:12px;font-size:.72rem;color:var(--navy);display:flex;align-items:center;gap:8px;font-weight:700;text-transform:uppercase;}

/* ══ IMPORTADO BADGE ══ */
.imported-badge{display:inline-flex;align-items:center;gap:3px;background:#e3f2fd;color:#1565C0;padding:2px 8px;border-radius:10px;font-size:.62rem;font-weight:700;letter-spacing:.04em;}
.imported-row td{background:#f5faff !important;}
.imported-row:hover td{background:#ebf4ff !important;}
.total-importado{font-weight:900;color:#1565C0;font-size:.9rem;}
.imported-info{font-size:.66rem;color:#888;font-style:italic;margin-top:1px;}

@media(max-width:640px){.sidebar{display:none;}.layout{display:block;}.main{padding:14px;}}
</style>
</head>
<body>

<!-- ══ LOGIN ══ -->
<div id="login-screen" class="login-wrap">
  <div class="login-box">
    <!-- Logo SRA -->
    <div style="display:flex;justify-content:center;margin-bottom:14px">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="90" height="90" style="color:var(--navy)">
        <circle cx="100" cy="100" r="96" fill="none" stroke="currentColor" stroke-width="5"/>
        <circle cx="100" cy="100" r="85" fill="none" stroke="currentColor" stroke-width="1.2"/>
        <circle cx="100" cy="100" r="79" fill="none" stroke="currentColor" stroke-width="1"/>
        <path id="arc-top" d="M 22,100 A 78,78 0 0,1 178,100" fill="none"/>
        <text font-size="9.5" font-family="serif" font-weight="700" fill="currentColor" letter-spacing="2.2">
          <textPath href="#arc-top" startOffset="50%" text-anchor="middle">CULTIVAR EL SUELO ES SERVIR A LA PATRIA</textPath>
        </text>
        <path id="arc-bot" d="M 35,130 A 78,78 0 0,0 165,130" fill="none"/>
        <text font-size="10" font-family="serif" font-weight="700" fill="currentColor" letter-spacing="1">
          <textPath href="#arc-bot" startOffset="50%" text-anchor="middle">· · · · · · · · · · · · · · · ·</textPath>
        </text>
        <text x="100" y="107" text-anchor="middle" font-family="serif" font-size="40" font-weight="900" fill="currentColor" letter-spacing="-1">SRA</text>
        <rect x="64" y="138" width="72" height="20" rx="2" fill="currentColor"/>
        <text x="100" y="153" text-anchor="middle" font-family="serif" font-size="12" font-weight="700" fill="#fff" letter-spacing="2">1866</text>
      </svg>
    </div>
    <div class="login-logo">Emprendados</div>
    <div class="login-sub">Concurso Nacional de Aperos · SRA</div>
    <div class="login-roles" style="grid-template-columns:1fr 1fr;max-width:260px;margin:0 auto 20px">
      <button class="role-btn" onclick="selectRole('admin')" id="role-admin">
        <span class="role-icon">👑</span>Admin
      </button>
      <button class="role-btn" onclick="selectRole('lectura')" id="role-lectura">
        <span class="role-icon">👁</span>Solo Lectura
      </button>
    </div>
    <div class="pin-wrap">
      <div class="pin-label">PIN de acceso</div>
      <input type="password" class="pin-input" id="pin-input" maxlength="6" placeholder="• • • • • •"
        onkeydown="if(event.key==='Enter')doLogin()">
    </div>
    <div class="login-err" id="login-err"></div>
    <button class="btn-login" onclick="doLogin()">Ingresar</button>
  </div>
</div>

<!-- ══ APP ══ -->
<div id="app" style="display:none">
  <div class="topbar">
    <div class="topbar-left" style="display:flex;align-items:center;gap:12px">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="38" height="38" style="color:#fff;flex-shrink:0">
        <circle cx="100" cy="100" r="96" fill="none" stroke="currentColor" stroke-width="6"/>
        <circle cx="100" cy="100" r="84" fill="none" stroke="currentColor" stroke-width="1"/>
        <path id="arc-t2" d="M 22,100 A 78,78 0 0,1 178,100" fill="none"/>
        <text font-size="9" font-family="serif" font-weight="700" fill="currentColor" letter-spacing="2">
          <textPath href="#arc-t2" startOffset="50%" text-anchor="middle">CULTIVAR EL SUELO ES SERVIR A LA PATRIA</textPath>
        </text>
        <text x="100" y="107" text-anchor="middle" font-family="serif" font-size="40" font-weight="900" fill="currentColor" letter-spacing="-1">SRA</text>
        <rect x="64" y="136" width="72" height="20" rx="2" fill="currentColor"/>
        <text x="100" y="151" text-anchor="middle" font-family="serif" font-size="12" font-weight="700" fill="var(--navy)" letter-spacing="2">1866</text>
      </svg>
      <div>
        <h1>Emprendados</h1>
        <p>Concurso Nacional de Aperos · SRA</p>
      </div>
    </div>
    <div class="topbar-right">
      <span class="role-badge" id="role-badge"></span>
      <button class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.3);font-size:.65rem" onclick="doLogout()">Salir</button>
      <button class="btn btn-gold btn-sm" id="btn-export" onclick="exportCurrentEvent()" style="display:none">⬇ Excel</button>
      <button class="btn btn-navy btn-sm" id="btn-import" onclick="openImportModal()" style="display:none;border:1.5px solid rgba(255,255,255,.3)">📥 Importar</button>
    </div>
  </div>
  <div class="sync-bar">
    <span class="sync-dot" id="sync-dot"></span>
    <span id="sync-label">Conectando...</span>
    <span style="margin-left:auto;opacity:.4" id="sync-time"></span>
  </div>
  <div class="event-tabs" id="event-tabs"></div>
  <div class="layout">
    <aside class="sidebar">
      <div class="mode-tabs" id="mode-tabs-wrap">
        <button class="modetab active" id="tab-insc" onclick="setMode('inscripcion')">Inscripción</button>
        <button class="modetab" id="tab-punt" onclick="setMode('puntajes')">Puntajes</button>
      </div>
      <div id="sidebar-content"></div>
    </aside>
    <main class="main" id="main-area"></main>
  </div>
</div>

<!-- Modal inscripción -->
<div class="overlay hidden" id="modal-insc">
  <div class="modal">
    <div class="modal-header">
      <h3 id="minsc-title">Agregar Inscripto</h3>
      <p id="minsc-sub"></p>
    </div>
    <div class="modal-body">
      <div class="field"><label>Apellido *</label><input id="f-apellido" placeholder="Apellido"></div>
      <div class="field"><label>Nombre *</label><input id="f-nombre" placeholder="Nombre"></div>
      <div class="field"><label>Nombre Ejemplar</label><input id="f-ejemplar" placeholder="Nombre del caballo"></div>
      <div class="field"><label>Teléfono</label><input id="f-tel" placeholder="Teléfono"></div>
      <div class="field full"><label>Mail</label><input id="f-mail" type="email" placeholder="correo@ejemplo.com"></div>
