function previewImport(input){
  const file=input.files[0];
  if(!file)return;
  const reader=new FileReader();
  reader.onload=function(e){
    try{
      const wb=XLSX.read(e.target.result,{type:'binary'});
      const ws=wb.Sheets[wb.SheetNames[0]];
      const rows=XLSX.utils.sheet_to_json(ws,{header:1,defval:''});
      if(rows.length<2){
        document.getElementById('import-preview').innerHTML='<p style="color:var(--red);font-size:.72rem">El archivo está vacío o no tiene datos.</p>';
        return;
      }
      const headers=rows[0].map(h=>String(h).trim().toLowerCase());
      const ci={
        etapa:  headers.findIndex(h=>h.includes('etapa')||h.includes('evento')||h==='e'),
        cat:    headers.findIndex(h=>h.includes('categor')||h.includes('cat')),
        apellido:headers.findIndex(h=>h.includes('apellido')),
        nombre: headers.findIndex(h=>h.includes('nombre')&&!h.includes('ejemplar')&&!h.includes('caballo')),
        ejemplar:headers.findIndex(h=>h.includes('ejemplar')||h.includes('caballo')),
        tel:    headers.findIndex(h=>h.includes('tel')||h.includes('cel')||h.includes('fono')),
        mail:   headers.findIndex(h=>h.includes('mail')||h.includes('email')||h.includes('correo')),
        puntaje:headers.findIndex(h=>h.includes('puntaje')||h.includes('total')||h.includes('pts')||h.includes('score')),
      };
      if(ci.apellido<0){
        document.getElementById('import-preview').innerHTML='<p style="color:var(--red);font-size:.72rem">⚠ No se encontró columna "Apellido". Revisá el formato.</p>';
        return;
      }
      importParsedData=rows.slice(1).filter(r=>r[ci.apellido]&&String(r[ci.apellido]).trim()).map(r=>({
        etapa: ci.etapa>=0?String(r[ci.etapa]).trim():'1',
        categoria:ci.cat>=0?String(r[ci.cat]).trim():'',
        apellido:String(r[ci.apellido]||'').trim().toUpperCase(),
        nombre:  ci.nombre>=0?String(r[ci.nombre]||'').trim():'',
        ejemplar:ci.ejemplar>=0?String(r[ci.ejemplar]||'').trim():'',
        tel:     ci.tel>=0?String(r[ci.tel]||'').trim():'',
        mail:    ci.mail>=0?String(r[ci.mail]||'').trim():'',
        puntaje: ci.puntaje>=0?parseFloat(r[ci.puntaje])||0:0,
      }));
      const sinCat=importParsedData.filter(r=>!resolveCatId(r.categoria)).length;
      const sinPts=importParsedData.filter(r=>r.puntaje===0).length;
      let html=`<div style="padding:10px;background:#e8f5e9;border-radius:4px;font-size:.72rem;color:#2E7D32">
        ✓ <strong>${importParsedData.length} filas</strong> leídas.
        ${sinPts>0?`<span style="color:#795548"> · ${sinPts} sin puntaje.</span>`:''}
        ${sinCat>0?`<span style="color:var(--red)"> · ⚠ ${sinCat} sin categoría reconocida.</span>`:''}
      </div>`;
      if(importParsedData.length>0){
        html+=`<div style="margin-top:8px;font-size:.7rem;color:#888;padding:6px 10px;background:#f5f5f5;border-radius:4px">
          Ejemplo fila 1: <strong>${importParsedData[0].apellido}</strong> ${importParsedData[0].nombre}
          — Cat: ${importParsedData[0].categoria||'(vacío)'}
          — Etapa: ${importParsedData[0].etapa}
          — Pts: ${importParsedData[0].puntaje}
        </div>`;
      }
      document.getElementById('import-preview').innerHTML=html;
    }catch(err){
      document.getElementById('import-preview').innerHTML=`<p style="color:var(--red);font-size:.72rem">Error al leer el archivo: ${err.message}</p>`;
    }
  };
  reader.readAsBinaryString(file);
}

function resolveEtapaId(s){
  const t=String(s).trim().toLowerCase().replace(/\s+/g,'');
  if(t==='1'||t==='e1'||t.includes('etapa1')||t.includes('evento1'))return 'e1';
  if(t==='2'||t==='e2'||t.includes('etapa2')||t.includes('evento2'))return 'e2';
  if(t==='3'||t==='e3'||t.includes('etapa3')||t.includes('evento3'))return 'e3';
  if(t==='4'||t==='e4'||t.includes('etapa4')||t.includes('evento4'))return 'e4';
  return 'e1';
}

function resolveCatId(catStr){
  if(!catStr)return null;
  const s=catStr.trim().toLowerCase();
  // Exact id
  const byId=CATEGORIES.find(c=>c.id.toLowerCase()===s);
  if(byId)return byId.id;
  // Short name
  const byShort=CATEGORIES.find(c=>c.short.toLowerCase()===s||s===c.short.toLowerCase());
  if(byShort)return byShort.id;
  // Partial name (at least 5 chars matching)
  const byName=CATEGORIES.find(c=>c.name.toLowerCase().includes(s)||s.includes(c.name.toLowerCase().substring(0,6)));
  if(byName)return byName.id;
  // fuzzy: category short words
  const byWord=CATEGORIES.find(c=>c.short.toLowerCase().split(' ').some(w=>w.length>3&&s.includes(w)));
  return byWord?byWord.id:null;
}

async function doImport(){
  const prog=document.getElementById('import-progress');
  const btnImp=document.getElementById('btn-do-import');
  prog.style.display='';
  btnImp.disabled=true;

  if(importMode==='excel'){
    if(!importParsedData||importParsedData.length===0){
      toast('⚠ Seleccioná un archivo primero');
      prog.style.display='none';btnImp.disabled=false;
      return;
    }
    let count=0, skipped=0;
    for(const row of importParsedData){
      const eid=resolveEtapaId(row.etapa);
      const catId=resolveCatId(row.categoria);
      if(!catId){skipped++;continue;}
      if(!state.inscripcion[eid])state.inscripcion[eid]={};
      if(!state.inscripcion[eid][catId])state.inscripcion[eid][catId]=[];
      if(!state.puntajes[eid])state.puntajes[eid]={};
      if(!state.puntajes[eid][catId])state.puntajes[eid][catId]=[];
      const slot=state.inscripcion[eid][catId].length;
      const obj={apellido:row.apellido,nombre:row.nombre,ejemplar:row.ejemplar,tel:row.tel,mail:row.mail};
      state.inscripcion[eid][catId].push(obj);
      state.puntajes[eid][catId].push({_total:row.puntaje});
      await saveInscriptoDB(eid,catId,slot,obj);
      await savePuntajeToDB(eid,catId,slot,{_total:row.puntaje});
      count++;
    }
    persist();
    closeModal('modal-import');
    renderAll();
    toast(`✓ ${count} inscriptos importados${skipped>0?' · '+skipped+' omitidos (categoría no reconocida)':''}`);
  } else {
    prog.textContent='Cargando datos de prueba...';
    await loadSampleData();
    closeModal('modal-import');
  }
  prog.style.display='none';btnImp.disabled=false;
}

