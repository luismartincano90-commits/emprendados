// HELPERS
// ══════════════════════════════════════════
function getInsc(eid,cid){return state.inscripcion[eid]&&state.inscripcion[eid][cid]?state.inscripcion[eid][cid]:[];}
function getScores(eid,cid){return state.puntajes[eid]&&state.puntajes[eid][cid]?state.puntajes[eid][cid]:[];}
function filledInsc(eid,cid){return getInsc(eid,cid).filter(r=>r&&r.apellido);}
function getCriteria(t){return CRITERIA[t];}
function getCatSlots(cid){const cat=CATEGORIES.find(c=>c.id===cid);return(state.catSlots&&state.catSlots[cid])||cat.slots;}
function getEvName(ev){return(state.eventNames&&state.eventNames[ev.id])||ev.name;}
function canEdit(){return ROLES[curRole]?.canEdit;}
function canScore(){return ROLES[curRole]?.canScore;}
function isReadOnly(){return !canEdit()&&!canScore();}

function calcTotal(catType,scoreObj){
  if(!scoreObj)return 0;
  // Soporte para puntajes importados (total directo sin criterios individuales)
  if(scoreObj._total!==undefined)return parseFloat(scoreObj._total)||0;
  const c=getCriteria(catType);
  if(catType==='apero2j'||catType==='amazonas'){
    let t=0;
    [...(c.caballos||[]),...(c.aperos||[])].forEach(col=>t+=parseFloat(scoreObj[col.key]||0));
    return t;
  }
  let t=0;(c.cols||[]).forEach(col=>t+=parseFloat(scoreObj[col.key]||0));return t;
}

function rankScores(eid,cid){
  const cat=CATEGORIES.find(c=>c.id===cid);
  const insc=getInsc(eid,cid);
  const scores=getScores(eid,cid);
  const tots=insc.map((_,i)=>scores[i]?calcTotal(cat.type,scores[i]):0);
  return tots.map(t=>{if(!t)return 0;return tots.filter(x=>x>t).length+1;});
}
function hasScores(eid,cid){return getScores(eid,cid).some(s=>s&&Object.values(s).some(v=>parseFloat(v||0)>0));}

function getClasificadosPorEtapa(catId,etapaId){
  const cat=CATEGORIES.find(c=>c.id===catId);
  const insc=getInsc(etapaId,catId);
  const scores=getScores(etapaId,catId);
  const ranks=rankScores(etapaId,catId);
  if(cat.directFinal)return insc.map((p,i)=>({...p,total:calcTotal(cat.type,scores[i]||{}),rank:ranks[i],etapa:etapaId})).filter(p=>p&&p.apellido);
  return insc.map((p,i)=>({...p,total:calcTotal(cat.type,scores[i]||{}),rank:ranks[i],etapa:etapaId}))
    .filter(p=>p&&p.apellido&&p.total>=cat.minPts&&p.rank>0).sort((a,b)=>a.rank-b.rank).slice(0,cat.maxClasif);
}

function getAllClasificadosParaPalermo(catId){
  const seen=new Map();
  ['e1','e2','e3','e4'].forEach(eid=>{
    getClasificadosPorEtapa(catId,eid).forEach(p=>{
      const key=(p.apellido+'|'+(p.nombre||'')).toLowerCase();
      if(!seen.has(key))seen.set(key,{...p,etapas:[eid],clasificoEn:[eid]});
      else seen.get(key).etapas.push(eid);
    });
  });
  return [...seen.values()];
}

function getParticipacionPorEtapa(catId){
  const allP=new Map();
  ['e1','e2','e3','e4'].forEach(eid=>{
    getInsc(eid,catId).forEach(r=>{
      if(r&&r.apellido){
        const key=(r.apellido+'|'+(r.nombre||'')).toLowerCase();
        if(!allP.has(key))allP.set(key,{...r,etapas:[]});
        if(!allP.get(key).etapas.includes(eid))allP.get(key).etapas.push(eid);
      }
    });
  });
  return allP;
}

