function handleEventNameKey(e,evId){e.stopPropagation();if(e.key==='Enter')saveEventName(evId);if(e.key==='Escape')renderEventTabs();}
function saveEventName(evId){
  const inp=document.getElementById(`etab-input-${evId}`);if(!inp)return;
  const val=inp.value.trim();
  if(val){if(!state.eventNames)state.eventNames={};state.eventNames[evId]=val;persist();saveConfigToDB('eventNames',state.eventNames);}
  renderEventTabs();
}
function getEvName(ev){return(state.eventNames&&state.eventNames[ev.id])||ev.name;}

function renderSidebar(){
  const el=document.getElementById('sidebar-content');
  document.getElementById('tab-insc').className='modetab'+(curMode==='inscripcion'?' active':'');
  document.getElementById('tab-punt').className='modetab'+(curMode==='puntajes'?' active':'');

  // Hide puntajes tab for admin/lectura in palermo if not scoring
  let html='<div class="sidebar-section">Categorías</div>';
  CATEGORIES.forEach(cat=>{
    const count=filledInsc(curEvent,cat.id).length;
    const slots=getCatSlots(cat.id);
    const hasSc=hasScores(curEvent,cat.id);
    const active=cat.id===curCat;
    html+=`<button class="catbtn ${active?'active':''} ${hasSc?'has-scores':''}" onclick="selectCat('${cat.id}')">
      <span style="line-height:1.3;font-size:.72rem">${cat.short}</span>
      <span class="badge">${count}/${slots}</span>
    </button>`;
  });
  el.innerHTML=html;
}

function renderMain(){
  const ev=EVENTS.find(e=>e.id===curEvent);
  if(ev.palermo&&curMode==='puntajes'){renderPalermoView();return;}
  if(ev.palermo&&curMode==='inscripcion'){renderPalermoInscripcion();return;}
  if(curMode==='inscripcion')renderInscripcion();
  else renderPuntajes();
}

// ══════════════════════════════════════════
// INSCRIPCIÓN VIEW
// ══════════════════════════════════════════
function renderInscripcion(){
  const ev=EVENTS.find(e=>e.id===curEvent);
  const cat=CATEGORIES.find(c=>c.id===curCat);
  const rows=getInsc(curEvent,curCat);
  const filled=rows.filter(r=>r&&r.apellido);
  const slots=getCatSlots(cat.id);
  const ma=document.getElementById('main-area');
  const ro=!canEdit();

  let html='';
  if(ro) html+=`<div class="readonly-notice">👁 Modo solo lectura — no podés modificar inscriptos</div>`;

  html+=`<div class="page-header">
    <div><h2>${cat.name}</h2>
    <p>${getEvName(ev)} · ${filled.length} inscripto${filled.length!==1?'s':''} de ${slots} lugares</p></div>
    <div class="page-header-actions">
      ${!ro?`<button class="btn btn-gold btn-sm" onclick="openInscModal(null)">+ Agregar</button>`:''}
    </div>
  </div>`;

  if(canEdit()){
    html+=`<div class="slots-bar">
      <label>Cupos</label>
      <input type="number" class="slots-input" min="1" max="200" value="${slots}" onchange="updateCatSlots(this.value)">
      <p>Cupos disponibles en esta categoría</p>
    </div>`;
  }

  html+=`<div class="table-wrap"><table>
    <thead><tr><th>#</th><th>Apellido y Nombre</th><th>Ejemplar</th><th>Teléfono</th><th>Mail</th>${!ro?'<th>Acciones</th>':''}</tr></thead>
    <tbody>`;

  for(let i=0;i<slots;i++){
    const r=rows[i];
    if(r&&r.apellido){
      html+=`<tr><td class="num-cell">${i+1}</td>
        <td class="name-cell left"><strong>${r.apellido}</strong>${r.nombre?' '+r.nombre:''}</td>
        <td class="left">${r.ejemplar||'—'}</td>
        <td>${r.tel||'—'}</td>
        <td>${r.mail||'—'}</td>
        ${!ro?`<td style="white-space:nowrap">
          <button class="btn btn-ghost btn-xs" onclick="openInscModal(${i})">✏</button>
          <button class="btn btn-danger btn-xs" style="margin-left:3px" onclick="deleteInsc(${i})">✕</button>
        </td>`:''}
      </tr>`;
    } else {
      html+=`<tr class="empty-row">
        <td class="num-cell" style="color:#ddd">${i+1}</td>
        <td colspan="${ro?4:3}" style="color:#ddd;font-style:italic">— lugar disponible —</td>
        ${!ro?`<td><button class="btn btn-ghost btn-xs" onclick="openInscModal(${i})">+</button></td>`:''}
      </tr>`;
    }
  }
  html+=`</tbody></table></div>`;
  ma.innerHTML=html;
}

function updateCatSlots(v){
  const n=parseInt(v);if(!n||n<1||n>200)return;
  if(!state.catSlots)state.catSlots={};
  state.catSlots[curCat]=n;persist();
  saveConfigToDB('catSlots',state.catSlots);
  renderMain();
}

// ══════════════════════════════════════════
// PUNTAJES VIEW
// ══════════════════════════════════════════
function renderPuntajes(){
  const ev=EVENTS.find(e=>e.id===curEvent);
  const cat=CATEGORIES.find(c=>c.id===curCat);
  const insc=getInsc(curEvent,curCat);
  const scores=getScores(curEvent,curCat);
  const filled=insc.filter(r=>r&&r.apellido);
  const ranks=rankScores(curEvent,curCat);
  const crit=getCriteria(cat.type);
  const ma=document.getElementById('main-area');
  const role=ROLES[curRole];

  const canEditCab=role.canScore===true||role.canScore==='caballos';
  const canEditApe=role.canScore===true||role.canScore==='aperos';
  const canEditAll=role.canScore===true;

  if(filled.length===0){
    ma.innerHTML=`<div class="page-header"><div><h2>${cat.name}</h2><p>${getEvName(ev)}</p></div></div>
    <div style="text-align:center;padding:60px;color:#bbb"><p style="font-size:.85rem">No hay inscriptos. Primero agregalos en Inscripción.</p></div>`;
    return;
  }

  // Detectar si hay filas importadas en este evento/categoría
  const totalFilled=filled.length;
  const importedCount=filled.filter((_,i)=>{const idx=insc.findIndex((r,j)=>r&&r.apellido&&insc.slice(0,j+1).filter(x=>x&&x.apellido).length-1===i);return scores[idx]&&scores[idx]._total!==undefined;}).length;
  // Simplificado: contar cuántas filas tienen _total
  let importedRows=0;
  insc.forEach((_,i)=>{if(scores[i]&&scores[i]._total!==undefined)importedRows++;});
  const allImported=importedRows>0&&importedRows===insc.filter(r=>r&&r.apellido).length;

  let html='';
  if(!role.canScore) html+=`<div class="readonly-notice">👁 Solo podés ver los puntajes, no editarlos</div>`;
  if(importedRows>0) html+=`<div class="readonly-notice" style="background:#e3f2fd;border-color:#1565C0;color:#1565C0">
    📥 <strong>${importedRows} resultado${importedRows!==1?'s':''} importado${importedRows!==1?'s':''}</strong> de clasificatoria — puntaje total registrado
  </div>`;

  html+=`<div class="page-header">
    <div><h2>${cat.name}</h2>
    <p>${getEvName(ev)} · ${totalFilled} participantes · Máx. ${crit.maxPts} pts${allImported?' · <span style="color:#1565C0;font-weight:700">📥 Clasificatoria importada</span>':''}</p></div>
    <div class="page-header-actions">
      ${role.canScore&&!allImported?`<button class="btn btn-navy btn-sm" onclick="saveScores()">💾 Guardar</button>`:''}
    </div>
  </div>`;

  // ── Si es todo importado: tabla de resultados limpia ──
  if(allImported){
    html+=`<div class="table-wrap"><table id="score-table">
      <thead><tr>
        <th>#</th><th style="text-align:left">Participante</th><th>Ejemplar</th>
        <th>Puntaje</th><th>/ Máx.</th><th>%</th><th>Rank</th><th>Clasifica</th>
      </tr></thead><tbody>`;
    const sorted=[...insc.map((p,i)=>({p,i})).filter(({p})=>p&&p.apellido)]
      .sort((a,b)=>(calcTotal(cat.type,scores[b.i]||{}))-(calcTotal(cat.type,scores[a.i]||{})));
    sorted.forEach(({p,i})=>{
      const s=scores[i]||{};
      const tot=calcTotal(cat.type,s);
      const rank=ranks[i];
      const rankClass=rank===1?'rank-1':rank===2?'rank-2':rank===3?'rank-3':'';
      const pct=crit.maxPts>0?Math.round(tot/crit.maxPts*100):0;
      const clasifica=cat.directFinal||(tot>=cat.minPts&&rank>0&&rank<=cat.maxClasif);
      html+=`<tr data-row="${i}" class="imported-row">
        <td class="num-cell">${i+1}</td>
        <td class="name-cell left"><strong>${p.apellido}</strong>${p.nombre?' '+p.nombre:''}</td>
        <td style="font-size:.72rem;color:#888">${p.ejemplar||'—'}</td>
        <td class="total-importado">${tot>0?tot.toFixed(1):'—'}</td>
        <td style="font-size:.68rem;color:#aaa">${crit.maxPts}</td>
        <td style="font-size:.72rem;font-weight:700;color:${pct>=70?'var(--green)':pct>=50?'var(--navy)':'#999'}">${tot>0?pct+'%':'—'}</td>
        <td class="rank-cell ${rankClass}">${rank>0?'#'+rank:'—'}</td>
        <td style="text-align:center">${clasifica?'<span style="color:var(--green);font-weight:700;font-size:.75rem">✓ Clasifica</span>':'<span style="color:#ddd;font-size:.72rem">—</span>'}</td>
      </tr>`;
    });
    html+=`</tbody></table></div>`;
    ma.innerHTML=html;
    return;
  }

  // ── Vista mixta o solo puntaje manual ──
  html+=`<div class="table-wrap"><table id="score-table"><thead>`;
  if(cat.type==='apero2j'||cat.type==='amazonas'){
    const cabCols=crit.caballos;const apCols=crit.aperos;
    html+=`<tr>
      <th>#</th><th>Participante</th>
      <th colspan="${cabCols.length}" class="jury-header">JURADO CABALLOS</th><th>Sub Cab.</th>
      <th colspan="${apCols.length}" class="jury-header">JURADO APEROS</th><th>Sub Ape.</th>
      <th>TOTAL</th><th>Rank</th><th>Obs.</th>
    </tr><tr>
      <th></th><th></th>
      ${cabCols.map(c=>`<th style="font-size:.6rem">${c.label}<br><span style="color:var(--navy)">≤${c.max}</span></th>`).join('')}
      <th></th>
      ${apCols.map(c=>`<th style="font-size:.6rem">${c.label}<br><span style="color:var(--navy)">≤${c.max}</span></th>`).join('')}
      <th></th><th></th><th></th><th></th>
    </tr>`;
  } else {
    html+=`<tr><th>#</th><th>Participante</th>
      ${crit.cols.map(c=>`<th style="font-size:.6rem">${c.label}<br><span style="color:var(--navy)">≤${c.max}</span></th>`).join('')}
      <th>TOTAL</th><th>Rank</th><th>Obs.</th>
    </tr>`;
  }
  html+=`</thead><tbody>`;

  insc.forEach((p,i)=>{
    if(!p||!p.apellido)return;
    const s=scores[i]||{};
    const tot=calcTotal(cat.type,s);
    const rank=ranks[i];
    const rankClass=rank===1?'rank-1':rank===2?'rank-2':rank===3?'rank-3':'';
    const isImp=s._total!==undefined;

    if(isImp){
      // Fila importada dentro de tabla mixta
      const colSpan=cat.type==='apero2j'||cat.type==='amazonas'
        ?crit.caballos.length+1+crit.aperos.length+1
        :crit.cols.length;
      html+=`<tr data-row="${i}" class="imported-row">
        <td class="num-cell">${i+1}</td>
        <td class="name-cell left"><strong>${p.apellido}</strong>${p.nombre?' '+p.nombre:''}<br><span class="imported-info">${p.ejemplar||''}</span></td>
        <td colspan="${colSpan}" style="text-align:center"><span class="imported-badge">📥 Importado</span></td>
        <td class="total-importado">${tot>0?tot.toFixed(1):'—'}</td>
        <td class="rank-cell ${rankClass}">${rank>0?'#'+rank:'—'}</td>
        <td></td>
      </tr>`;
    } else if(cat.type==='apero2j'||cat.type==='amazonas'){
      const cabCols=crit.caballos;const apCols=crit.aperos;
      let subCab=0,subApe=0;
      cabCols.forEach(c=>subCab+=parseFloat(s[c.key]||0));
      apCols.forEach(c=>subApe+=parseFloat(s[c.key]||0));
      html+=`<tr data-row="${i}">
        <td class="num-cell">${i+1}</td>
        <td class="name-cell left"><strong>${p.apellido}</strong>${p.nombre?' '+p.nombre:''}</td>
        ${cabCols.map(c=>`<td><input type="number" min="0" max="${c.max}" step="0.5" class="score-input" data-idx="${i}" data-key="${c.key}" data-max="${c.max}" value="${s[c.key]!==undefined?s[c.key]:''}" ${!canEditCab?'disabled':''} oninput="onScoreInput(this)"></td>`).join('')}
        <td class="subtotal-cell">${subCab.toFixed(1)}</td>
        ${apCols.map(c=>`<td><input type="number" min="0" max="${c.max}" step="0.5" class="score-input" data-idx="${i}" data-key="${c.key}" data-max="${c.max}" value="${s[c.key]!==undefined?s[c.key]:''}" ${!canEditApe?'disabled':''} oninput="onScoreInput(this)"></td>`).join('')}
        <td class="subtotal-cell">${subApe.toFixed(1)}</td>
        <td class="total-cell">${tot>0?tot.toFixed(1):'—'}</td>
        <td class="rank-cell ${rankClass}">${rank>0?'#'+rank:'—'}</td>
        <td><input type="text" class="obs-input" data-idx="${i}" data-key="obs" value="${s.obs||''}" ${!role.canScore?'disabled':''} onchange="onObsInput(this)" placeholder="Obs."></td>
      </tr>`;
    } else {
      html+=`<tr data-row="${i}">
        <td class="num-cell">${i+1}</td>
        <td class="name-cell left"><strong>${p.apellido}</strong>${p.nombre?' '+p.nombre:''}</td>
        ${crit.cols.map(c=>`<td><input type="number" min="0" max="${c.max}" step="0.5" class="score-input" data-idx="${i}" data-key="${c.key}" data-max="${c.max}" value="${s[c.key]!==undefined?s[c.key]:''}" ${!canEditAll?'disabled':''} oninput="onScoreInput(this)"></td>`).join('')}
        <td class="total-cell">${tot>0?tot.toFixed(1):'—'}</td>
        <td class="rank-cell ${rankClass}">${rank>0?'#'+rank:'—'}</td>
        <td><input type="text" class="obs-input" data-idx="${i}" data-key="obs" value="${s.obs||''}" ${!canEditAll?'disabled':''} onchange="onObsInput(this)" placeholder="Obs."></td>
      </tr>`;
    }
  });
  html+=`</tbody></table></div>`;
  ma.innerHTML=html;
}

function onScoreInput(el){
  const idx=parseInt(el.dataset.idx);
  const key=el.dataset.key;
  const max=parseFloat(el.dataset.max);
  const val=parseFloat(el.value)||0;
  el.classList.toggle('over',val>max);
  if(!state.puntajes[curEvent][curCat][idx])state.puntajes[curEvent][curCat][idx]={};
  state.puntajes[curEvent][curCat][idx][key]=el.value===''?undefined:parseFloat(el.value);
  updateTotalsInDOM();
}
function onObsInput(el){
  const idx=parseInt(el.dataset.idx);
  if(!state.puntajes[curEvent][curCat][idx])state.puntajes[curEvent][curCat][idx]={};
  state.puntajes[curEvent][curCat][idx].obs=el.value;
}
function updateTotalsInDOM(){
  const cat=CATEGORIES.find(c=>c.id===curCat);
  const insc=getInsc(curEvent,curCat);
  const scores=state.puntajes[curEvent][curCat];
  const ranks=rankScores(curEvent,curCat);
  insc.forEach((p,i)=>{
    if(!p||!p.apellido)return;
    const s=scores[i]||{};
    const tot=calcTotal(cat.type,s);
    const rank=ranks[i];
    const row=document.querySelector(`tr[data-row="${i}"]`);if(!row)return;
    const tc=row.querySelector('.total-cell');const rc=row.querySelector('.rank-cell');
    if(tc)tc.textContent=tot>0?tot.toFixed(1):'—';
    if(rc){rc.textContent=rank>0?'#'+rank:'—';rc.className='rank-cell '+(rank===1?'rank-1':rank===2?'rank-2':rank===3?'rank-3':'');}
    if(cat.type==='apero2j'||cat.type==='amazonas'){
      const crit=getCriteria(cat.type);
      let sc=0,sa=0;
      crit.caballos.forEach(c=>sc+=parseFloat(s[c.key]||0));
      crit.aperos.forEach(c=>sa+=parseFloat(s[c.key]||0));
      const subs=row.querySelectorAll('.subtotal-cell');
      if(subs[0])subs[0].textContent=sc.toFixed(1);
      if(subs[1])subs[1].textContent=sa.toFixed(1);
    }
  });
}

async function saveScores(){
  persist();
  // Push each filled score to DB
  const scores=state.puntajes[curEvent][curCat];
  for(let i=0;i<scores.length;i++){
    if(scores[i]&&Object.keys(scores[i]).length>0){
      await savePuntajeToDB(curEvent,curCat,i,scores[i]);
    }
  }
  renderSidebar();
  toast('✓ Puntajes guardados');
}

