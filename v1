function exportCurrentEvent(){
  const ev=EVENTS.find(e=>e.id===curEvent);
  const wb=XLSX.utils.book_new();
  const inscData=[['N°','Categoría','Apellido y Nombre','Ejemplar','Teléfono','Mail']];
  CATEGORIES.forEach(cat=>{
    const rows=getInsc(ev.id,cat.id);
    for(let i=0;i<getCatSlots(cat.id);i++){
      const r=rows[i];
      inscData.push([i+1,cat.name,r&&r.apellido?`${r.apellido} ${r.nombre||''}`:'',r&&r.ejemplar||'',r&&r.tel||'',r&&r.mail||'']);
    }
  });
  const wsI=XLSX.utils.aoa_to_sheet(inscData);
  XLSX.utils.book_append_sheet(wb,wsI,'Inscripcion');
  CATEGORIES.forEach(cat=>{
    const crit=getCriteria(cat.type);
    const insc=getInsc(ev.id,cat.id);
    const scores=getScores(ev.id,cat.id);
    const ranks=rankScores(ev.id,cat.id);
    let rows=[[cat.name],[]];
    if(cat.type==='apero2j'||cat.type==='amazonas'){
      rows.push(['N°','Nombre',...crit.caballos.map(c=>c.label),'Sub Caballos',...crit.aperos.map(c=>c.label),'Sub Aperos','TOTAL','Rank','Obs']);
      insc.forEach((p,i)=>{if(!p||!p.apellido)return;
        const s=scores[i]||{};let sc=0,sa=0;
        crit.caballos.forEach(c=>sc+=parseFloat(s[c.key]||0));
        crit.aperos.forEach(c=>sa+=parseFloat(s[c.key]||0));
        rows.push([i+1,`${p.apellido} ${p.nombre||''}`,...crit.caballos.map(c=>s[c.key]||''),sc||'',...crit.aperos.map(c=>s[c.key]||''),sa||'',(sc+sa)||'',ranks[i]||'',s.obs||'']);
      });
    } else {
      rows.push(['N°','Nombre',...crit.cols.map(c=>c.label),'TOTAL','Rank','Obs']);
      insc.forEach((p,i)=>{if(!p||!p.apellido)return;
        const s=scores[i]||{};const tot=calcTotal(cat.type,s);
        rows.push([i+1,`${p.apellido} ${p.nombre||''}`,...crit.cols.map(c=>s[c.key]||''),tot||'',ranks[i]||'',s.obs||'']);
      });
    }
    const ws=XLSX.utils.aoa_to_sheet(rows);
    XLSX.utils.book_append_sheet(wb,ws,cat.short.substring(0,31));
  });
  XLSX.writeFile(wb,`Emprendados_SRA_${getEvName(ev).replace(/\s+/g,'_')}.xlsx`);
  toast(`✓ Excel exportado: ${getEvName(ev)}`);
}

